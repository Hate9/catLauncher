<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Transparent window over the system wallpaper; Compose draws everything else. -->
    <style name="Theme.CatLauncher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>

    <!-- For the pin-shortcut confirmation: translucent so the caller stays visible underneath. -->
    <style name="Theme.CatLauncher.Translucent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
